; Engine configuration file.
; It's best edited using the editor UI and not directly

config_version=5

[application]

name="Rocket League Mobile"
run/main_scene="res://src/ui/main_menu.tscn"
config/features=PackedStringArray("4.4")
boot_splash/bg_color=Color(0.05, 0.05, 0.08, 1)
config/icon="res://assets/icon.png"
config/splash="res://assets/splash.png"
boot_splash/image="res://assets/splash.png"

[layer_names]

3d_physics/layer_1="world_static"
3d_physics/layer_2="car_chassis"
3d_physics/layer_3="wheels"
3d_physics/layer_4="ball"
3d_physics/layer_5="boost_pads"
3d_physics/layer_6="sensors"

[physics]
common/physics_ticks_per_second=120

